# Required: session signing secret (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Required: shared password for the demo accounts (min 8 chars)
DEMO_PASSWORD=

# Gemini: set ONE of these. Without them TrustLens runs its built-in demo agents.
GEMINI_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=europe-west1
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs: enables voices, the debate podcast and voice questions
ELEVENLABS_API_KEY=
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_VOICE_NARRATOR=
# ELEVENLABS_VOICE_SCOUT=
# ELEVENLABS_VOICE_CRITIC=
# ELEVENLABS_VOICE_ARBITER=
