# Required: session signing secret (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Required: shared password for the demo accounts (min 8 chars)
DEMO_PASSWORD=

# Claude (Anthropic) powers the three agents. Without a key TrustLens runs its built-in demo agents.
ANTHROPIC_API_KEY=your-anthropic-api-key
# CLAUDE_MODEL=claude-opus-5

# ElevenLabs: agent voices and the debate podcast
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_VOICE_NARRATOR=
# ELEVENLABS_VOICE_SCOUT=
# ELEVENLABS_VOICE_CRITIC=
# ELEVENLABS_VOICE_ARBITER=
